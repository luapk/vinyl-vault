{
  "crons": [
    {
      "path": "/api/import-worker",
      "schedule": "*/2 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/legal/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy.html"
    },
    {
      "source": "/refunds",
      "destination": "/legal/refunds.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/scan.js": {
      "maxDuration": 60
    },
    "api/discogs-search.js": {
      "maxDuration": 15
    },
    "api/import-worker.js": {
      "maxDuration": 300
    },
    "api/spotify-features.js": {
      "maxDuration": 30
    },
    "api/stripe-checkout.js": {
      "maxDuration": 15
    },
    "api/stripe-portal.js": {
      "maxDuration": 15
    },
    "api/stripe-webhook.js": {
      "maxDuration": 15
    },
    "api/trace.js": {
      "maxDuration": 30
    }
  }
}